DATABASE_URL=postgres://olps:olps@127.0.0.1:5434/olps
PORT=8787
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
REMOTE_SERVICE_URL=http://127.0.0.1:8790
REMOTE_SERVICE_TOKEN=olps-remote-dev-token
# 下列 REMOTE_* 供远端进程使用；@olps/remote 不读取本文件，启动远端时须在终端显式设置（见根 README）
REMOTE_PUBLIC_BASE_URL=http://127.0.0.1:8790
REMOTE_PORT=8790
REMOTE_DATA_ROOT=.intermediate/remote-data
SANDBOX_ROOT=.intermediate/sandboxes
PUBLISH_ROOT=.intermediate/publish
PREVIEW_ROOT=.intermediate/preview
OLPS_DEFAULT_SCREEN_CAP=20
CURSOR_AGENT_COMMAND=cursor-agent
# Docker 中处理合并冲突时使用；本机也可以通过 cursor-agent login 登录。
CURSOR_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
# 本机开发使用 LLM_WIKI_ROOT；Docker 使用 LLM_WIKI_HOST_PATH 挂载只读知识目录。
LLM_WIKI_ROOT=
LLM_WIKI_HOST_PATH=
LLM_WIKI_ALLOWED_ACCOUNTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Legacy 迁移（仅 sites 仍含 tenant_id 时；启动 API 前设置，详见 docs/migration-rehearsal.md）
# MIGRATION_SITE_OWNERS={"legacy-site-id":["account1"]}
# MIGRATION_KB_OWNERS={"legacy-kb-id":["account1"]}
# bootstrap CLI（services/api：npx tsx src/migration-bootstrap-users.ts）
# MIGRATION_BOOTSTRAP_USERS=[{"account":"account1","name":"Display"}]
# MIGRATION_BOOTSTRAP_CREDENTIALS_PATH=/path/outside/repo/credentials.json
# Vitest 集成测试数据库（须包含 _test_）
TEST_DATABASE_URL=postgres://olps:olps@127.0.0.1:5434/olps_test_api
# npm run mvp:check 可选固定账号
# MVP_CHECK_ACCOUNT=
# MVP_CHECK_PASSWORD=
