<header class="olps-site-header">
  <div class="olps-shell olps-header-inner">
    <a class="olps-brand" href="{{ 'home' | role_url }}">{% if appearance.logo %}<img class="olps-brand-logo" src="{{ appearance.logo | media_url }}" alt="{{ site.siteName | escape }}">{% endif %}{{ site.siteName }}</a>
    <nav aria-label="{{ 'menu' | t }}">
      {% include 'parts/menu.liquid', items: menus.primary, menuClass: 'olps-nav' %}
    </nav>
    <nav aria-label="{{ 'language' | t }}">
      <ul class="olps-lang">
        {%- for entry in alternates -%}
          <li>
            <a href="{{ entry.url }}" hreflang="{{ entry.code }}"{% if entry.code == locale.code %} aria-current="page"{% endif %}>{{ entry.name }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</header>
