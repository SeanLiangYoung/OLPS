<footer class="olps-site-footer">
  <div class="olps-shell olps-footer-inner">
    <div>
      <p>{{ site.company.name }}</p>
      <p>
        {% for entry in legalLinks %}
          <a href="{{ entry.url }}">{{ entry.title }}</a>
          ·
        {% endfor %}
        <button type="button" class="olps-cookie-settings" data-olps-cookie-settings>{{ 'cookie_settings' | t }}</button>
      </p>
    </div>
  </div>
</footer>
