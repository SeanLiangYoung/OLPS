<section class="olps-section" data-olps-section="logo-wall">
  {% if block.props.heading and block.props.heading != blank %}
    <h2>{{ block.props.heading }}</h2>
  {% endif %}
  <div class="olps-logo-wall">
    {% for logo in block.props.logos %}
      <div class="olps-card">{{ logo.name }}</div>
    {% endfor %}
  </div>
</section>
