<!DOCTYPE html>
<html lang="{{ locale.code }}" dir="{{ locale.dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
    {% include 'parts/settings.liquid' %}
  </head>
  <body>
    {% include 'parts/header.liquid' %}
    <main class="olps-shell olps-main" data-olps-template="page-not-found">
      <h1 class="olps-page-title">{{ page.title }}</h1>
      <div data-olps-content>
        {{ content }}
      </div>
    </main>
    {% include 'parts/footer.liquid' %}
  </body>
</html>
