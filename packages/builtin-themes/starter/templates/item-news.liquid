<!DOCTYPE html>
<html lang="{{ locale.code }}" dir="{{ locale.dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
  </head>
  <body>
    {% include 'parts/header.liquid' %}
    <main class="olps-shell olps-main" data-olps-template="item-news">
      {% include 'parts/breadcrumbs.liquid' %}
      <h1 class="olps-page-title">{{ item.title }}</h1>
      <div data-olps-content>
        {{ content }}
      </div>
      <div class="olps-item-nav">
        {% if previous %}
          <p>{{ 'previous' | t }}: <a href="{{ previous.url }}">{{ previous.title }}</a></p>
        {% endif %}
        {% if next %}
          <p>{{ 'next' | t }}: <a href="{{ next.url }}">{{ next.title }}</a></p>
        {% endif %}
      </div>
    </main>
    {% include 'parts/footer.liquid' %}
  </body>
</html>
