{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olps.dev/schemas/v1/publish-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "siteId", "publicSiteUrl", "publicApiBaseUrl", "hostingBasePath", "connectors", "conversionSettings", "indexNowKey"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "siteId": { "type": "string", "minLength": 1 },
    "publicSiteUrl": { "type": "string", "pattern": "^(?:https://[^\\s]+|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?(?:/[^\\s]*)?)$" },
    "publicApiBaseUrl": { "type": "string", "pattern": "^(?:https://[^\\s]+|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?(?:/[^\\s]*)?)$" },
    "hostingBasePath": { "type": "string", "pattern": "^/(?:[^?#]*/)?$" },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ga4": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurementId"],
          "properties": { "measurementId": { "type": "string", "minLength": 1 } }
        },
        "googleAds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversionId", "conversionLabel"],
          "properties": {
            "conversionId": { "type": "string", "minLength": 1 },
            "conversionLabel": { "type": "string", "minLength": 1 }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pixelId"],
          "properties": { "pixelId": { "type": "string", "minLength": 1 } }
        },
        "searchConsole": {
          "type": "object", "additionalProperties": false, "required": ["verificationMeta"],
          "properties": { "verificationMeta": { "type": "string", "minLength": 1 } }
        },
        "gtm": {
          "type": "object", "additionalProperties": false, "required": ["containerId"],
          "properties": { "containerId": { "type": "string", "pattern": "^GTM-[A-Z0-9]+$" } }
        },
        "tiktok": {
          "type": "object", "additionalProperties": false, "required": ["pixelId"],
          "properties": { "pixelId": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" } }
        },
        "linkedin": {
          "type": "object", "additionalProperties": false, "required": ["partnerId"],
          "properties": { "partnerId": { "type": "string", "pattern": "^[0-9]+$" }, "conversionId": { "type": "string", "pattern": "^[0-9]+$" } }
        },
        "clarity": {
          "type": "object", "additionalProperties": false, "required": ["projectId"],
          "properties": { "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" } }
        },
        "uet": {
          "type": "object", "additionalProperties": false, "required": ["tagId"],
          "properties": { "tagId": { "type": "string", "pattern": "^[0-9]+$" } }
        }
      }
    },
    "conversionSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submitInquiry", "qualifiedInquiry"],
      "properties": {
        "submitInquiry": { "type": "boolean" },
        "qualifiedInquiry": { "type": "boolean" }
      }
    },
    "indexNowKey": { "type": "string", "minLength": 1 }
  }
}
