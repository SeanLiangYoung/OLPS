{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olps.dev/schemas/v1/section.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "category", "fields", "accepts", "preview"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "fields": { "type": "array", "items": { "$ref": "#/definitions/field" } },
    "accepts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:(?:core|theme)/[a-z][a-z0-9-]*|plugin/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*)$"
      }
    },
    "preview": { "type": "object" }
  },
  "definitions": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label", "required", "translatable"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
        "type": { "enum": ["text", "richtext", "media", "mediaList", "link", "select", "color", "number", "boolean", "list"] },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "translatable": { "type": "boolean" },
        "default": true,
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/option" } },
        "itemFields": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/field" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": { "properties": { "options": true }, "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": { "properties": { "itemFields": true }, "required": ["itemFields"] }
        }
      ]
    }
  }
}
