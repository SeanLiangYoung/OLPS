{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olps.dev/schemas/v1/theme.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "author", "description", "requires", "settings", "menus", "templates", "styles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "requires": { "type": "string", "minLength": 1 },
    "settings": { "type": "array", "items": { "$ref": "#/definitions/field" } },
    "menus": { "type": "array", "items": { "$ref": "#/definitions/namedEntry" } },
    "templates": { "type": "array", "items": { "$ref": "#/definitions/namedEntry" } },
    "styles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": {
    "namedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label", "required", "translatable"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
        "type": { "enum": ["text", "richtext", "media", "mediaList", "link", "select", "color", "number", "boolean", "list"] },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "translatable": { "type": "boolean" },
        "default": true,
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/option" } },
        "itemFields": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/field" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": { "properties": { "options": true }, "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": { "properties": { "itemFields": true }, "required": ["itemFields"] }
        }
      ]
    }
  }
}
