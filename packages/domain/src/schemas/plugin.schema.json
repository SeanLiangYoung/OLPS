{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olps.dev/schemas/v1/plugin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "author", "description", "requires", "settings", "snippets", "assets", "server", "permissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "requires": { "type": "string", "minLength": 1 },
    "settings": { "type": "array", "items": { "$ref": "#/definitions/field" } },
    "snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "position", "scope"],
        "properties": {
          "file": { "type": "string", "pattern": "^snippets/(?!.*\\.\\.).+\\.liquid$" },
          "position": { "enum": ["head", "body-end"] },
          "scope": { "enum": ["all", "pages-with-block"] }
        }
      }
    },
    "assets": { "type": "array", "items": { "type": "string", "pattern": "^assets/(?!.*\\.\\.).+" } },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "const": "server/build.js" },
        "api": { "const": "server/api.js" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": { "type": "boolean" },
        "inquiries": { "type": "boolean" },
        "fetch": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
        }
      }
    }
  },
  "definitions": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label", "required", "translatable"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
        "type": { "enum": ["text", "richtext", "media", "mediaList", "link", "select", "color", "number", "boolean", "list", "secret"] },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "translatable": { "type": "boolean" },
        "default": true,
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/option" } },
        "itemFields": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/field" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": { "properties": { "options": true }, "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": { "properties": { "itemFields": true }, "required": ["itemFields"] }
        }
      ]
    }
  }
}
