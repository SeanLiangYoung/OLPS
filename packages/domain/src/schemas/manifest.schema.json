{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olps.dev/schemas/v1/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifyCommand"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verifyCommand": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
