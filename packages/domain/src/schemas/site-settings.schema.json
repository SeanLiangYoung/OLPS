{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olps.dev/schemas/v1/site-settings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "siteName", "siteUrl", "company", "iconMediaId", "socialLinks", "locales", "defaultLocale", "search"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "siteName": { "type": "string", "minLength": 1 },
    "siteUrl": { "type": "string", "pattern": "^(?:https?://[^\\s]+)?$" },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "phone", "email"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
      }
    },
    "iconMediaId": { "type": ["string", "null"] },
    "socialLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url"],
        "properties": {
          "platform": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "dir"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$" },
          "dir": { "enum": ["ltr", "rtl"] }
        }
      }
    },
    "defaultLocale": { "type": "string" },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowIndexing", "allowAiSearch", "allowAiTraining"],
      "properties": {
        "allowIndexing": { "type": "boolean" },
        "allowAiSearch": { "type": "boolean" },
        "allowAiTraining": { "type": "boolean" }
      }
    }
  }
}
