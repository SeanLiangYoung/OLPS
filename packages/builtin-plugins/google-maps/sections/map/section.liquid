<section class="olps-google-maps" data-olps-plugin="google-maps">
  <h2>{{ 'maps_heading' | t }}</h2>
  <p class="olps-map-address" data-olps-map-address>100 Industry Road</p>
  <p>
    <a
      href="https://www.google.com/maps/search/?api=1&amp;query=100+Industry+Road"
      target="_blank"
      rel="noopener noreferrer"
    >
      {{ 'maps_open' | t }}
    </a>
  </p>
</section>
<script src="/assets/plugin/google-maps/map.js" defer></script>
