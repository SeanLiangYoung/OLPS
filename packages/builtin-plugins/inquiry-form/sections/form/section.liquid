<section class="olps-inquiry-form" data-olps-plugin="inquiry-form">
  <h2>{{ 'inquiry_heading' | t }}</h2>
  <form data-olps-inquiry-form data-olps-form-id="{{ block.id }}" data-olps-submit-error="{{ 'inquiry_submit_error' | t | escape }}" method="post" action="#">
    <p>
      <label for="olps-inquiry-name-{{ block.id | escape }}">{{ 'inquiry_name' | t }}</label>
      <input id="olps-inquiry-name-{{ block.id | escape }}" name="name" type="text" required autocomplete="name">
    </p>
    <p>
      <label for="olps-inquiry-email-{{ block.id | escape }}">{{ 'inquiry_email' | t }}</label>
      <input id="olps-inquiry-email-{{ block.id | escape }}" name="email" type="email" required autocomplete="email">
    </p>
    <p>
      <label for="olps-inquiry-message-{{ block.id | escape }}">{{ 'inquiry_message' | t }}</label>
      <textarea id="olps-inquiry-message-{{ block.id | escape }}" name="message" rows="5" required></textarea>
    </p>
    <p>
      <label>
        <input name="privacyConsent" type="checkbox" required>
        {{ 'inquiry_privacy_prefix' | t }}
        <a href="{{ 'privacy' | role_url }}">{{ 'inquiry_privacy_link' | t }}</a>
      </label>
    </p>
    <p data-olps-inquiry-error hidden></p>
    <p>
      <button class="olps-button" type="submit">{{ 'inquiry_submit' | t }}</button>
    </p>
  </form>
</section>
<script src="/assets/plugin/inquiry-form/form.js" defer></script>
