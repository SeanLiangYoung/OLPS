{
  "schemaVersion": 1,
  "id": "whatsapp",
  "name": "WhatsApp",
  "version": "1.0.0",
  "author": "OLPS",
  "description": "WhatsApp contact button and optional floating snippet.",
  "requires": "1",
  "settings": [
    {
      "key": "phone",
      "type": "text",
      "label": "WhatsApp number",
      "required": false,
      "translatable": false,
      "default": ""
    },
    {
      "key": "buttonLabel",
      "type": "text",
      "label": "Default button label",
      "required": false,
      "translatable": true
    },
    {
      "key": "position",
      "type": "select",
      "label": "Floating button position",
      "required": false,
      "translatable": false,
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-right"
    }
  ],
  "snippets": [
    {
      "file": "snippets/button.liquid",
      "position": "body-end",
      "scope": "all"
    }
  ],
  "assets": ["assets/whatsapp.js"],
  "server": {},
  "permissions": {}
}
