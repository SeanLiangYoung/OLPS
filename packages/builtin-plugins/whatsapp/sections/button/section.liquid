<section class="olps-whatsapp" data-olps-plugin="whatsapp">
  {% assign phone = block.props.phone | default: plugin.settings.phone | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' %}
  {% assign label = block.props.label | default: plugin.settings.buttonLabel %}
  {% if phone != blank %}
  <a
    class="olps-button"
    data-olps-whatsapp-button
    href="https://wa.me/{{ phone | url_encode }}"
    target="_blank"
    rel="noopener noreferrer"
  >
    {% if label != blank %}{{ label | escape }}{% else %}{{ 'whatsapp_button' | t }}{% endif %}
  </a>
  {% endif %}
</section>
<script src="/assets/plugin/whatsapp/whatsapp.js" defer></script>
