<section class="olps-section" data-olps-section="gallery">
  {% if block.props.heading and block.props.heading != blank %}
    <h2>{{ block.props.heading }}</h2>
  {% endif %}
  <div class="olps-gallery">
    {% for item in block.props.items %}
      <figure class="olps-card">
        <figcaption>{{ item.caption }}</figcaption>
      </figure>
    {% endfor %}
  </div>
</section>
