<section class="olps-section" data-olps-section="stats">
  {% if block.props.heading and block.props.heading != blank %}
    <h2>{{ block.props.heading }}</h2>
  {% endif %}
  <div class="olps-stats">
    {% for item in block.props.items %}
      <div class="olps-stat">
        <p><strong>{{ item.value }}</strong></p>
        <p>{{ item.label }}</p>
      </div>
    {% endfor %}
  </div>
</section>
