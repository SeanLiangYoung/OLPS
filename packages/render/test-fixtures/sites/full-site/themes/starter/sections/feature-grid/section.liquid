<section class="olps-section" data-olps-section="feature-grid">
  {% if block.props.heading and block.props.heading != blank %}
    <h2>{{ block.props.heading }}</h2>
  {% endif %}
  <div class="olps-feature-grid">
    {% for feature in block.props.features %}
      <article class="olps-feature">
        <h3>{{ feature.title }}</h3>
        {% if feature.text and feature.text != blank %}
          <p>{{ feature.text }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>
